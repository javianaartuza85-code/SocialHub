# ─── Supabase (Project Settings → API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: NUNCA la compartas ni la pongas en el navegador
SUPABASE_SERVICE_ROLE_KEY=

# ─── Dirección pública de la app (ej. https://social-hub.vercel.app) ─
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Seguridad: escribe textos largos y aleatorios (mín. 32 caracteres)
# Protege la tarea automática que publica y envía recordatorios
CRON_SECRET=
# Cifra los tokens de Meta guardados en la base de datos
TOKEN_ENCRYPTION_KEY=

# ─── Meta (opcional; déjalo vacío para usar solo el modo manual) ─────
META_APP_ID=
META_APP_SECRET=
